# ============================================================
# DevSecOps Supply-Chain Platform — environment configuration
# Copy this file to .env and fill in real values. NEVER commit .env.
# ============================================================

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---
POSTGRES_USER=devsecops
POSTGRES_PASSWORD=change_me_local_dev_password
POSTGRES_DB=devsecops
DATABASE_URL=postgresql+psycopg://devsecops:change_me_local_dev_password@db:5432/devsecops

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- CI ingestion shared secret ---
# Set the SAME value here and as a GitHub Actions repo secret named INGEST_API_KEY.
INGEST_API_KEY=REPLACE_WITH_A_RANDOM_VALUE

# --- Optional: live GitHub App integration for PR comments / Check Runs ---
# Without these, the platform works fully (scanning, storage, dashboard, gate
# decisions) but /scans/{id}/report-to-github returns HTTP 501 "not configured".
# To enable: create a GitHub App with permissions: Checks (write), Pull requests (write),
# Contents (read); install it on your repo(s); set:
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
